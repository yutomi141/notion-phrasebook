# Notion API
# Notion Integration Token（サーバー側のみ使用。絶対にブラウザへ公開しない）
NOTION_TOKEN=secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Notion DB IDs（Notionページ URL から取得）
NOTION_PHRASE_DB_ID=your-phrase-db-id-here
NOTION_SCRIPT_LIBRARY_DB_ID=your-script-library-db-id-here
NOTION_SCRIPT_SENTENCES_DB_ID=your-script-sentences-db-id-here
NOTION_REVIEW_LOG_DB_ID=your-review-log-db-id-here
# CLAUDE.md の Notion MCPで参照する要件定義ページのID（Claude Code専用・任意）
NOTION_REQUIREMENTS_PAGE_ID=your-requirements-page-id-here

# 認証（本人以外のアクセスを防ぐ）
# `openssl rand -base64 32` で生成する
AUTH_SECRET=your_auth_secret_here
# アクセスを許可するGoogleアカウントのメールアドレス
AUTH_ALLOWED_EMAIL=your_email@gmail.com
# Google OAuth（https://console.cloud.google.com/ で取得）
AUTH_GOOGLE_ID=your_google_client_id
AUTH_GOOGLE_SECRET=your_google_client_secret

# 間隔反復アルゴリズム設定（省略時はデフォルト値を使用）
SRS_INITIAL_INTERVAL_DAYS=1
SRS_SECOND_INTERVAL_DAYS=3
SRS_EASE_FACTOR=2.5
SRS_MAX_INTERVAL_DAYS=365
SRS_MASTERED_STREAK=3
SRS_MASTERED_INTERVAL_DAYS=7

# アプリURL（本番デプロイ時に設定）
NEXTAUTH_URL=http://localhost:3000
